rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── CMS config — public read, no client-side deletes ───────────────────
    match /config/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /site_content/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // ─── Gallery — public read; admin CMS add/update/delete ───────────────────
    match /galleries/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // ─── Live print queue (webbooth → webprinter) ────────────────────────────
    match /print_jobs/{jobId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ─── Bookings — public create with validation, no client deletes ─────────
    match /bookings/{bookingId} {
      allow create: if isValidBookingCreate();
      allow read, update: if true;
      allow delete: if false;
    }

    // ─── WhatsApp AI Agent ───────────────────────────────────────────────────
    // TODO: require request.auth != null once all API routes use firebase-admin
    match /wa_conversations/{document=**} {
      allow read, write: if true;
    }
    match /wa_agent_settings/{document=**} {
      allow read, write: if true;
    }
    match /wa_kb_documents/{document=**} {
      allow read, write: if true;
    }
  }

  function isValidBookingCreate() {
    return request.resource.data.keys().hasAll(['eventDate', 'venue', 'pax', 'services'])
      && request.resource.data.pax is int
      && request.resource.data.pax > 0
      && request.resource.data.pax < 100000
      && request.resource.data.services is list;
  }
}
