# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.visriva.com

# Google Search Console — paste the meta tag "content" value only (see docs/operations/google-search-console.md)
# GOOGLE_SITE_VERIFICATION=

# ─── Firebase Web App (client) ───────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Firebase Admin (server API routes) ──────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Admin / Operator PINs (comma-separated, case-insensitive) ───────────────
# Required for /admin and /operator access. Example:
# NEXT_PUBLIC_ADMIN_PASSWORDS=password1,password2,password3
# Default master PIN 4848 works when this is empty.
# SECURITY: NEXT_PUBLIC_* is compiled into the client bundle and readable in the
# browser. These PINs are a UI gate only, not real server auth (see SECURITY.md).
NEXT_PUBLIC_ADMIN_PASSWORDS=

# ─── Operations Hub session ──────────────────────────────────────────────────
# Operations Hub PINs (comma-separated). Falls back to team first names if unset.
# OPERATIONS_PINS=pin1,pin2
# HMAC secret used to SIGN the operations session cookie so it cannot be forged.
# Set a long random value (e.g. `openssl rand -hex 32`). If unset, the server
# falls back to CRON_SECRET / WHATSAPP_APP_SECRET / META_APP_SECRET.
OPS_SESSION_SECRET=

# ─── Live Station print routing ──────────────────────────────────────────────
# Local DNP print server (laptop USB). Default: http://localhost:3847
NEXT_PUBLIC_PRINT_SERVER_URL=http://localhost:3847
# Optional: full URL to Next.js app on print laptop (iPad booth POST target)
# NEXT_PUBLIC_PRINT_API_URL=http://192.168.1.50:3000

# ─── Supabase Photo Booth (print queue + keepsake storage) ───────────────────
# Project: Super base Photo Booth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional newer publishable key format (if using Supabase API keys v2)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ─── Google Maps (venue autocomplete in booking form) ────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── WhatsApp — Meta Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_ACCESS_TOKEN=
# Token you set in the Meta webhook config (GET verification challenge).
WHATSAPP_VERIFY_TOKEN=
# App Secret from the Meta app dashboard — used to VERIFY the X-Hub-Signature-256
# on inbound webhook POSTs so they can't be spoofed. Required for enforcement.
WHATSAPP_APP_SECRET=
META_APP_SECRET=
# Inbound webhook signature enforcement is ON when an app secret is set.
# Emergency kill switch only (leave unset in normal operation):
# WHATSAPP_WEBHOOK_ENFORCE_SIGNATURE=false

# ─── WhatsApp — Evolution API (Baileys / self-hosted) ────────────────────────
# Production runs on Railway (api.visriva.com has no DNS record yet):
EVOLUTION_API_URL=https://evolution-api-production-d446.up.railway.app
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=visriva-live
# Set to "true" only for self-signed TLS certs on your Evolution VPS
EVOLUTION_INSECURE_TLS=false

# ─── Cron keep-alive (Vercel Cron / external scheduler) ─────────────────────
# Requires Authorization: Bearer <CRON_SECRET> on /api/whatsapp/cron.
# The endpoint now FAILS CLOSED: if this is unset the cron route rejects all
# requests. Vercel Cron injects this header automatically when the var is set.
CRON_SECRET=
