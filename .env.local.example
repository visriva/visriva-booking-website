# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.visriva.com

# ─── Firebase Web App (client) ───────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── Firebase Admin (server API routes) ──────────────────────────────────────
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Admin / Operator PINs (comma-separated, case-insensitive) ───────────────
# Required for /admin and /operator access. Example:
# NEXT_PUBLIC_ADMIN_PASSWORDS=password1,password2,password3
NEXT_PUBLIC_ADMIN_PASSWORDS=

# ─── Google Maps (venue autocomplete in booking form) ────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ─── WhatsApp — Meta Cloud API ───────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_ACCESS_TOKEN=

# ─── WhatsApp — Evolution API (Baileys / self-hosted) ────────────────────────
EVOLUTION_API_URL=https://your-evolution-server.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=visriva-live
# Set to "true" only for self-signed TLS certs on your Evolution VPS
EVOLUTION_INSECURE_TLS=false

# ─── Cron keep-alive (Vercel Cron / external scheduler) ─────────────────────
# Optional: require Authorization: Bearer <CRON_SECRET> on /api/whatsapp/cron
CRON_SECRET=
